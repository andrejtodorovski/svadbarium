# Copy to .env for local overrides, or set these directly in your hosting platform's
# environment variable settings (Railway/Render project settings).

# Postgres connection. Locally via docker-compose this is jdbc:postgresql://postgres:5432/venuedb
# (the app container reaches Postgres by service name). Railway/Render usually inject DATABASE_URL
# as postgres://user:pass@host:port/db instead — the app converts that format automatically at
# startup, so you can paste it in as-is.
DATABASE_URL=jdbc:postgresql://localhost:5433/venuedb
DATABASE_USERNAME=venue
DATABASE_PASSWORD=venue_dev_password

# HS256 signing secret for admin JWTs — must be at least 32 bytes. Generate a real one per
# deployment, e.g.: openssl rand -base64 48
JWT_SECRET=local-dev-only-change-me-local-dev-only-change-me

# The first (and only) admin account, seeded by the V2__seed_admin.sql Flyway migration on first
# boot. ADMIN_PASSWORD_HASH must be a bcrypt hash, not a plaintext password — generate one with:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# Defaults below (admin / changeme123) are for local dev only — always set real values before
# deploying a venue, since this migration runs once and isn't re-run if you change these later
# (see docs/new-venue-checklist.md for how to rotate credentials after the fact).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$ezQ2ycTY9Wb7xMiqS79ZHO/BsJxOKnYZrkwMNRaCIFeYqyeHor726
